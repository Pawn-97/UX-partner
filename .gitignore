# macOS
.DS_Store

# Runtime project workspaces (per-project data, not tracked)
/projects/*/
!/projects/.gitkeep

# Generated KB index artifacts (user-specific paths, regeneratable)
/kb-classification.md
/kb-index-manifest.json
/.kb-local-index.json
/.kb-setup-stamp

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Cursor: commit project adapter skills/rules, ignore local settings/state
.cursor/*
!.cursor/skills/
!.cursor/skills/**
!.cursor/commands/
!.cursor/commands/**
!.cursor/rules/
!.cursor/rules/**

# Node
node_modules/
*.log
.npm/

# Python (in case future scripts use it)
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local environment
.env
.env.local
/.claude/

# Local-only notes (design history, Claude Code helper) — not for public repo
/docs/
/CLAUDE.md
